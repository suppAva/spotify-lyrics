# Maintainer: suppAva (https://github.com/suppAva)
pkgname=lyricsync
pkgver=3.0.0
pkgrel=1
pkgdesc='Spotify-synchronized lyrics for Linux terminals'
arch=('x86_64')
url='https://github.com/suppAva/spotify-lyrics'
license=('MIT')
depends=('cairo' 'coreutils' 'curl' 'glib2' 'glibc' 'libfyaml' 'libgcc' 'libunistring' 'pango' 'playerctl')
makedepends=('rust')
options=('!debug')
_archive="$pkgname-$pkgver.tar.gz"
_srcdir="spotify-lyrics-$pkgver"
source=("$_archive::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the SHA-256 of the published tag archive before submitting to the AUR.
sha256sums=('UNVERIFIED')

build() {
    cd "$srcdir/$_srcdir"
    cargo build --release --locked --offline --target "$CARCH-unknown-linux-gnu" --target-dir "$srcdir/target"
}

check() {
    cd "$srcdir/$_srcdir"
    cargo test --locked --offline --target "$CARCH-unknown-linux-gnu" --target-dir "$srcdir/target"
}

package() {
    cd "$srcdir/$_srcdir"
    install -Dm755 "$srcdir/target/$CARCH-unknown-linux-gnu/release/lyricsync" "$pkgdir/usr/bin/lyricsync"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md
    install -Dm644 examples/demo.lrc "$pkgdir/usr/share/doc/$pkgname/examples/demo.lrc"
}
